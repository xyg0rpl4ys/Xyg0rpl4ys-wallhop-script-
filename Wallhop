local function updateHighlights()
	for _, hl in pairs(highlights) do
		hl:Destroy()
	end
	table.clear(highlights)

	if highlightEnabled then
		for part, _ in pairs(selectedWalls) do
			if part and part:IsA("BasePart") then
				local hl = Instance.new("Highlight")
				hl.Adornee = part
				hl.FillTransparency = 1
				hl.OutlineColor = Color3.fromRGB(0, 255, 255)
				hl.OutlineTransparency = 0
				hl.Parent = part
				table.insert(highlights, hl)
			end
		end
	end
end

local function setupWallTouch(part)
	if not part or not part:IsA("BasePart") then return end
	if wallConnections[part] then return end
	
	local c1 = part.Touched:Connect(function(hit)
		if not isEnabled then return end
		local character = LocalPlayer.Character
		if not character then return end
		
		if hit and hit.Parent == character then
			touchingWalls[part] = true
		end
	end)
	
	local c2 = part.TouchEnded:Connect(function(hit)
		local character = LocalPlayer.Character
		if not character then return end
		
		if hit and hit.Parent == character then
			touchingWalls[part] = nil
		end
	end)
	
	wallConnections[part] = {c1, c2}
end

