local function refreshConfigList()
	for _, child in pairs(configListScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local success, files = pcall(function()
		return listfiles(CONFIG_FOLDER)
	end)

	if success and files then
		local count = 0
		for _, filePath in ipairs(files) do
			if filePath:sub(-5) == ".json" then
				local name = filePath:match("([^/\\]+)%.json$")
				if name then
					if currentSearchQuery == "" or name:lower():find(currentSearchQuery:lower()) then
						count = count + 1
						local cfgBtn = Instance.new("TextButton")
						cfgBtn.Size = UDim2.new(1, -4, 0, 26)
						cfgBtn.BackgroundColor3 = (selectedConfigName == name) and Color3.fromRGB(40, 160, 80) or Color3.fromRGB(150, 0, 25)
						cfgBtn.BackgroundTransparency = 0.3
						cfgBtn.Text = name
						cfgBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
						cfgBtn.TextSize = 11
						cfgBtn.Font = Enum.Font.FredokaOne
						cfgBtn.LayoutOrder = count
						cfgBtn.Parent = configListScroll

						local cbCorner = Instance.new("UICorner")
						cbCorner.CornerRadius = UDim.new(0, 6)
						cbCorner.Parent = cfgBtn

						local cbStroke = Instance.new("UIStroke")
						cbStroke.Color = Color3.fromRGB(255, 120, 140)
						cbStroke.Thickness = 1.5
						cbStroke.Transparency = 0.3
						cbStroke.Parent = cfgBtn

						cfgBtn.Activated:Connect(function()
							selectedConfigName = name
							configNameBox.Text = name
							refreshConfigList()
						end)
					end
				end
			end
		end
	end
end

