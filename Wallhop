circleBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = circleBtn.AbsolutePosition

		isHolding = true
		holdTimer = os.clock()
		task.spawn(function()
			task.wait(0.4)
			if isHolding and (os.clock() - holdTimer >= 0.4) then
				isHolding = false
				isMenuOpen = true
				menuFrame.Position = UDim2.new(0, circleBtn.AbsolutePosition.X, 0, circleBtn.AbsolutePosition.Y)
				menuFrame.Visible = true
				circleBtn.Visible = false
			end
		end)
	end
end)

circleBtn.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if dragging then
			dragging = false
			local dragDistance = (input.Position - dragStart).Magnitude
			if dragDistance < 10 and (os.clock() - holdTimer < 0.4) then
				isEnabled = not isEnabled
				if isEnabled then
					circleBtn.Text = "On"
					circleBtn.TextColor3 = Color3.fromRGB(80, 255, 120)
					wallhopToggleBtn.Text = "Wallhop : On"
				else
					circleBtn.Text = "Off"
					circleBtn.TextColor3 = Color3.fromRGB(255, 60, 60)
					wallhopToggleBtn.Text = "Wallhop : Off"
				end
			end
		end
		isHolding = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		if delta.Magnitude > 10 then
			isHolding = false
		end
		
		local newX = startPos.X + delta.X
		local newY = startPos.Y + delta.Y
		
		local viewport = workspace.CurrentCamera.ViewportSize
		newX = math.clamp(newX, 10, viewport.X - 60)
		newY = math.clamp(newY, 10, viewport.Y - 60)
		
		circleBtn.Position = UDim2.new(0, newX, 0, newY)
	end
end)

