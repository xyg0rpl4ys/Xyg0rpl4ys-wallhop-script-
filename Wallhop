local isFlicking = false

RunService.RenderStepped:Connect(function()
	if not isEnabled or isFlicking then return end

	local character = LocalPlayer.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid then return end

	for wall, _ in pairs(touchingWalls) do
		if wall and wall.Parent and selectedWalls[wall] then
			local wallTopY = wall.Position.Y + (wall.Size.Y / 2)
			local verticalDiff = math.abs(hrp.Position.Y - wallTopY)
			
			if verticalDiff <= (3.5 + gapFilter) then
				isFlicking = true
				
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
				
				local angleMultiplier = (flickDirection == "left") and -1 or 1
				local baseDegrees = (wallhopMode == "blatant") and (flickDegree * 2) or flickDegree
				local flickAngle = math.rad(baseDegrees * angleMultiplier)
				local tweenInfo = TweenInfo.new(flickSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
				
				if flickMethod == "camera" then
					local camera = workspace.CurrentCamera
					local currentCFrame = camera.CFrame
					
					local targetCFrame1 = currentCFrame * CFrame.Angles(0, flickAngle, 0)
					local tw1 = TweenService:Create(camera, tweenInfo, {CFrame = targetCFrame1})
					tw1:Play()
					tw1.Completed:Wait()
					
					local tw2 = TweenService:Create(camera, tweenInfo, {CFrame = currentCFrame})
					tw2:Play()
					tw2.Completed:Wait()
				else
					local origCF = hrp.CFrame
					local targetCF = origCF * CFrame.Angles(0, flickAngle, 0)
					
					local tw1 = TweenService:Create(hrp, tweenInfo, {CFrame = targetCF})
					tw1:Play()
					tw1.Completed:Wait()
					
					local tw2 = TweenService:Create(hrp, tweenInfo, {CFrame = origCF})
					tw2:Play()
					tw2.Completed:Wait()
				end
				
				isFlicking = false
				break
			end
		end
	end
end)

