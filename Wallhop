-- Higher Up Notification System (Red Liquid Glass) 🔴✨
local function showCustomNotification(titleText, bodyText, duration, callback)
	local notifFrame = Instance.new("Frame")
	notifFrame.Size = UDim2.new(0, 140, 0, 56)
	notifFrame.Position = UDim2.new(1, 20, 0.65, 0)
	notifFrame.BackgroundColor3 = Color3.fromRGB(150, 0, 25)
	notifFrame.BackgroundTransparency = 0.35
	notifFrame.ClipsDescendants = true
	notifFrame.ZIndex = 10
	notifFrame.Parent = screenGui

	local nCorner = Instance.new("UICorner")
	nCorner.CornerRadius = UDim.new(0, 6)
	nCorner.Parent = notifFrame

	local nStroke = Instance.new("UIStroke")
	nStroke.Color = Color3.fromRGB(255, 100, 120)
	nStroke.Thickness = 1
	nStroke.Transparency = 0.2
	nStroke.Parent = notifFrame

	local titleLbl = Instance.new("TextLabel")
	titleLbl.Size = UDim2.new(1, -8, 0, 12)
	titleLbl.Position = UDim2.new(0, 4, 0, 2)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Text = titleText
	titleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLbl.TextSize = 8
	titleLbl.Font = Enum.Font.FredokaOne
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.ZIndex = 12
	titleLbl.Parent = notifFrame

	local bodyLbl = Instance.new("TextLabel")
	bodyLbl.Size = UDim2.new(1, -8, 0, 18)
	bodyLbl.Position = UDim2.new(0, 4, 0, 14)
	bodyLbl.BackgroundTransparency = 1
	bodyLbl.Text = bodyText
	bodyLbl.TextColor3 = Color3.fromRGB(240, 240, 240)
	bodyLbl.TextSize = 7
	bodyLbl.Font = Enum.Font.FredokaOne
	bodyLbl.TextXAlignment = Enum.TextXAlignment.Left
	bodyLbl.TextYAlignment = Enum.TextYAlignment.Top
	bodyLbl.TextWrapped = true
	bodyLbl.ZIndex = 12
	bodyLbl.Parent = notifFrame

	local btn1 = Instance.new("TextButton")
	btn1.Size = UDim2.new(0, 60, 0, 16)
	btn1.Position = UDim2.new(0, 4, 1, -18)
	btn1.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
	btn1.BackgroundTransparency = 0.3
	btn1.Text = "Ok"
	btn1.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn1.TextSize = 7
	btn1.Font = Enum.Font.FredokaOne
	btn1.ZIndex = 12
	btn1.Parent = notifFrame

	local b1Corner = Instance.new("UICorner")
	b1Corner.CornerRadius = UDim.new(0, 3)
	b1Corner.Parent = btn1

	local btn2 = Instance.new("TextButton")
	btn2.Size = UDim2.new(0, 66, 0, 16)
	btn2.Position = UDim2.new(1, -70, 1, -18)
	btn2.BackgroundColor3 = Color3.fromRGB(180, 40, 50)
	btn2.BackgroundTransparency = 0.3
	btn2.Text = "I DON'T CARE"
	btn2.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn2.TextSize = 6
	btn2.Font = Enum.Font.FredokaOne
	btn2.ZIndex = 12
	btn2.Parent = notifFrame

	local b2Corner = Instance.new("UICorner")
	b2Corner.CornerRadius = UDim.new(0, 3)
	b2Corner.Parent = btn2

	local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local slideIn = TweenService:Create(notifFrame, tweenInfo, {Position = UDim2.new(1, -150, 0.65, 0)})
	slideIn:Play()

	local dismissed = false
	local function dismiss(response)
		if dismissed then return end
		dismissed = true

		local slideOut = TweenService:Create(notifFrame, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {Position = UDim2.new(1, 20, 0.65, 0)})
		slideOut:Play()
		slideOut.Completed:Wait()
		notifFrame:Destroy()

		if callback then
			callback(response)
		end
	end

	btn1.Activated:Connect(function()
		dismiss("Ok")
	end)

	btn2.Activated:Connect(function()
		dismiss("I DON'T CARE")
	end)

	task.spawn(function()
		task.wait(duration)
		if not dismissed then
			dismiss("Timeout")
		end
	end)
end

